{
  "name": "studio-mean-frontend",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "echo \"frontend scaffold pending\"",
    "build:booking": "esbuild booking/booking.js --bundle --minify --drop:console --target=es2020 --outfile=booking/booking.min.js",
    "build:gutschein": "esbuild booking/gutschein/gutschein.js --bundle --minify --drop:console --target=es2020 --outfile=booking/gutschein/gutschein.min.js",
    "build:walkin": "esbuild booking/walkin/walkin.js --bundle --minify --drop:console --target=es2020 --outfile=booking/walkin/walkin.min.js",
    "build:consultation": "esbuild booking/consultation/consultation.js --bundle --minify --drop:console --target=es2020 --outfile=booking/consultation/consultation.min.js",
    "build:select": "esbuild select/select.js --bundle --minify --drop:console --target=es2020 --outfile=select/select.min.js",
    "build:select:v2": "esbuild select/v2/select.js --bundle --minify --drop:console --target=es2020 --outfile=select/v2/select.min.js",
    "build:portfolio": "esbuild portfolio/portfolio.js --bundle --minify --drop:console --target=es2020 --outfile=portfolio/portfolio.min.js",
    "build:promo": "esbuild booking/promo/promo.js --bundle --minify --drop:console --target=es2020 --outfile=booking/promo/promo.min.js",
    "build:css:booking": "esbuild booking/booking.css --minify --outfile=booking/booking.min.css",
    "build:css:gutschein": "esbuild booking/gutschein/gutschein.css --minify --outfile=booking/gutschein/gutschein.min.css",
    "build:css:walkin": "esbuild booking/walkin/walkin.css --minify --outfile=booking/walkin/walkin.min.css",
    "build:css:consultation": "esbuild booking/consultation/consultation.css --minify --outfile=booking/consultation/consultation.min.css",
    "build:css:select": "esbuild select/select.css --minify --outfile=select/select.min.css",
    "build:css:select:v2": "esbuild select/v2/select.css --minify --outfile=select/v2/select.min.css",
    "build:css:portfolio": "esbuild portfolio/portfolio.css --minify --outfile=portfolio/portfolio.min.css",
    "build:css:promo": "esbuild booking/promo/promo.css --minify --outfile=booking/promo/promo.min.css",
    "refresh:portfolio-data": "zsh portfolio/refresh-drive-data.sh",
    "build:booking-site": "npm run build:booking && npm run build:gutschein && npm run build:walkin && npm run build:consultation && npm run build:promo && npm run build:css:booking && npm run build:css:gutschein && npm run build:css:walkin && npm run build:css:consultation && npm run build:css:promo",
    "build:select-site": "npm run build:select && npm run build:css:select && npm run build:select:v2 && npm run build:css:select:v2",
    "build:portfolio-site": "npm run build:portfolio && npm run build:css:portfolio",
    "build": "npm run build:booking-site && npm run build:select-site"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
