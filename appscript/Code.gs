        exchangeNote=`마이리얼트립 원화결제 ${quote.krwAmount.toLocaleString()}원 / 환율 ${quote.rate.toFixed(6)} / 환산 ${priceText} / 기준 ${quote.fetchedAt}`;
      }else{
        // MRT 확정완료 메일에는 판매금액이 없다 → 0€ 가등록 허용, 파트너센터 확인 후 수기 입력.
        priceEuro=0;
        priceText='0€';
        priceDisplayText='0€ (₩미확인 / MyRealTrip)';
