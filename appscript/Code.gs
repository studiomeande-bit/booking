function _extractDriveFolderId_(url){
  if(!url)return'';
  const m1=String(url).match(/\/folders\/([A-Za-z0-9_-]{10,})/);
  if(m1)return m1[1];
  const m2=String(url).match(/[?&]id=([A-Za-z0-9_-]{10,})/);
  if(m2)return m2[1];
  const m3=String(url).match(/^([A-Za-z0-9_-]{15,})$/);
