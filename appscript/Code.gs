  const vatExempt=isVatExempt_(q.vatMode);
  const totals=_calcQuoteTotals_(items,q.discount,q.vatMode);
  const fmtD=s=>{const p=String(s||'').split('-');return p.length===3?`${p[2]}/${p[1]}/${p[0]}`:String(s||'');};
  const fmtDate=fmtD(q.issuedAt);
