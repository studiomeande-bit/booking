  const issued=parseDateSafe_(row[INVOICE_COL['발행일']]||'').str||String(row[INVOICE_COL['발행일']]||'');
  let items=[];
  try{items=JSON.parse(String(row[INVOICE_COL['품목JSON']]||'[]'));}catch(e){items=[];}
