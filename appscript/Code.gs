    stockCreatedAt:String(row[GUTSCHEIN_COL['재고생성일']]||'').trim(),
    saleRegisteredAt:String(row[GUTSCHEIN_COL['판매등록일']]||'').trim(),
    issueMode:String(row[GUTSCHEIN_COL['발행방식']]||'').trim(),
