          const prev=String(row[BOOKING_COL['촬영종류']]||'').trim();
          if(prev===next) return jsonOk_({ok:true,unchanged:true,rowIndex:rIdx,name:name,itemGroup:next,note:'이미 같은 값입니다.'});
          if(payload.dryRun===true){
