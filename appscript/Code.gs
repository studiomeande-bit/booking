</div>`;
  };
  const pagesHtml=pageLangs.map(function(L,i){return buildPage(L,i,i>0);}).join('');
  /* CSS 는 buildInvoiceHtml_ 와 동일 세트(2026-07-29 사장님 요청: 견적서 디자인 = 인보이스).
     인보이스 쪽 스타일을 바꾸면 여기도 같이 바꿔야 두 문서가 계속 같은 얼굴을 유지한다.
