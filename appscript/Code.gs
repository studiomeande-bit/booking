    const emailToSave = data.email || '수기등록(메일없음)';
    const langToSave = data.lang || 'ko';
    const nowStr=Utilities.formatDate(new Date(),CONFIG.TIMEZONE,'yyyy-MM-dd HH:mm:ss');
