      };
    });
  const todayOpenBlocks=getStudioAutoOpenBlocksForDate_(dateStr,detailedEvents).map(function(block){
    return `${('0'+block.startHour).slice(-2)}:${('0'+block.startMin).slice(-2)}–${('0'+block.endHour).slice(-2)}:${('0'+block.endMin).slice(-2)}`;
  });
