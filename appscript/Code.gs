    lang,
    localProductName,
    location:detailLocation,
    paymentMethod:'미결제',
    hideDuration:true
  });
  const isQuoteOnly=!!quote.isQuoteOnly;
  const priceHtml=isQuoteOnly
    ? (lang==='en'
        ? '■ Pricing: A custom quote will be sent after review.<br>'
