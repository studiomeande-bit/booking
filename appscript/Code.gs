    preferredSchedule:String(payload.preferredSchedule||'').trim(),
    passCountries:String(payload.passCountries||'').trim(),
    passPurpose:String(payload.passPurpose||'').trim(),
    passPeople:String(payload.passPeople||'').trim(),
