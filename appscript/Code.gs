    if(g.status!==GUTSCHEIN_STATUS.HOLD) throw new Error('예약중(hold) 상태가 아닙니다.');
    _releaseGutscheinHoldCells_(gutscheinSheet,found.rowIndex,'admin');
    return {ok:true};
  }finally{try{lock.releaseLock();}catch(e){}}
}

