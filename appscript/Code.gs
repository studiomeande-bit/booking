  const bookingRowIndex=parseInt(row[INVOICE_COL['예약행번호']])||0;
  const depositValue=type==='셀렉추가금' ? 0 : (parseFloat(row[INVOICE_COL['계약금(€)']])||0);
  const parsedTotal=parseFloat(row[INVOICE_COL['총금액(€)']])||0;
